<?xml version="1.0" encoding="utf-8"?>
<!-- What the microphone is hearing, over the search it will fill in -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center_horizontal"
    android:minWidth="360dp"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/voice_mic"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/voice_search_mic_background"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="24dp"
        android:src="@drawable/ic_mic"
        android:tint="?attr/colorOnPrimaryContainer" />

    <TextView
        android:id="@+id/voice_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/voice_search_speak_now"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/voice_words"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
</LinearLayout>
