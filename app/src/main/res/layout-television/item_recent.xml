<?xml version="1.0" encoding="utf-8"?>
<!-- TV: the card follows the image's proportions and names the file over it -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:focusable="true"
    android:foreground="?selectableItemBackground"
    style="@style/Widget.Material3.CardView.Filled"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardUseCompatPadding="true">

    <dev.dworks.apps.anexplorer.ui.ThumbFrameLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/grid_item_height">

        <dev.dworks.apps.anexplorer.ui.RatioImageView
            android:id="@+id/icon_thumb"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <dev.dworks.apps.anexplorer.ui.CircleImage
            android:id="@+id/icon_mime_background"
            android:layout_width="@dimen/grid_icon_size"
            android:layout_height="@dimen/grid_icon_size"
            android:layout_gravity="center"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/icon_mime"
            android:layout_width="@dimen/grid_icon_size"
            android:layout_height="@dimen/grid_icon_size"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="centerInside" />

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/recent_title_scrim"
            android:ellipsize="end"
            android:paddingStart="12dp"
            android:paddingTop="24dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@android:color/white" />

    </dev.dworks.apps.anexplorer.ui.ThumbFrameLayout>

</com.google.android.material.card.MaterialCardView>
