<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer section header on TV: the D-pad cursor gets the same ring as items, since
     selecting a header collapses its section. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp"
            android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="28dp" />
                <solid android:color="@color/item_root_pressed" />
                <stroke android:width="3dp" android:color="?attr/colorSecondary" />
            </shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp"
            android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="28dp" />
                <solid android:color="@color/item_root_pressed" />
                <stroke android:width="3dp" android:color="?attr/colorSecondary" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
