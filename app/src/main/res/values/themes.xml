<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="DocumentsTheme.Splash">
        <item name="windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="DocumentsTheme.Document">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>


    <!-- Static brand palette; values-v31 generates it from the user's color instead -->
    <style name="Base.DocumentsTheme" parent="@style/Theme.Material3Expressive.DayNight.NoActionBar.FocusRings">
        <item name="actionBarTheme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
        <item name="actionModeBackground">@color/alertDarkColor</item>

        <item name="colorPrimaryDark">@color/primaryDarkColor</item>
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/primaryContainerColor</item>
        <item name="colorOnPrimaryContainer">@color/onPrimaryContainerColor</item>
        <item name="colorSecondary">@color/accentColor</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorSecondaryContainer">@color/accentContainerColor</item>
        <item name="colorOnSecondaryContainer">@color/onAccentContainerColor</item>
        <item name="colorAccent">@color/accentColor</item>

        <item name="android:colorBackground">@color/surfaceColor</item>
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorOnSurface">@color/onSurfaceColor</item>
        <item name="colorSurfaceVariant">@color/surfaceVariantColor</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariantColor</item>
        <item name="colorOutline">@color/outlineColor</item>
        <item name="colorOutlineVariant">@color/outlineVariantColor</item>
        <item name="colorSurfaceContainerLowest">@color/surfaceContainerLowestColor</item>
        <item name="colorSurfaceContainerLow">@color/surfaceContainerLowColor</item>
        <item name="colorSurfaceContainer">@color/surfaceContainerColor</item>
        <item name="colorSurfaceContainerHigh">@color/surfaceContainerHighColor</item>
        <item name="colorSurfaceContainerHighest">@color/surfaceContainerHighestColor</item>
        <item name="colorControlNormal">@color/primary_text_default_material_dark</item>
        <item name="colorControlActivated">@color/primary_text_default_material_dark</item>
    </style>

    <style name="DocumentsTheme" parent="@style/Base.DocumentsTheme">
        <item name="actionBarWidgetTheme">@null</item>
        <item name="actionBarPopupTheme">@style/DocumentsTheme.PopupOverlay</item>
        <item name="actionBarStyle">@style/Custom.Widget.ActionBar</item>

        <!--<item name="android:listDivider">@drawable/list_divider_material</item>-->

        <item name="windowActionBar">false</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="*android:windowFixedWidthMajor">@null</item>
        <item name="*android:windowFixedWidthMinor">@null</item>
        <item name="*android:windowMinWidthMajor">@null</item>
        <item name="*android:windowMinWidthMinor">@null</item>
        <!--        <item name="*android:windowFixedHeightMajor">80%</item>-->
        <!--        <item name="*android:windowFixedHeightMinor">90%</item>-->

        <item name="android:windowSoftInputMode">stateUnspecified|adjustUnspecified</item>

        <!-- android transitions -->
        <item name="*android:windowContentTransitions">true</item>
        <item name="*android:windowAllowEnterTransitionOverlap">true</item>
        <item name="*android:windowAllowReturnTransitionOverlap">true</item>

        <item name="actionModeStyle">@style/Custom.Widget.ActionMode</item>
        <item name="actionModeCloseButtonStyle">@style/Custom.Widget.ActionButton.CloseMode</item>
        <item name="android:navigationBarColor" tools:targetApi="26">#303030</item>
    </style>

    <style name="DocumentsTheme.PopupOverlay" parent="@style/ThemeOverlay.Material3Expressive.Light">
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorOnSurface">@color/onSurfaceColor</item>
        <item name="colorSurfaceContainer">@color/surfaceContainerColor</item>
        <item name="colorSurfaceContainerHigh">@color/surfaceContainerHighColor</item>
    </style>

    <!-- Unpainted bars sitting on the window surface, e.g. on TV -->
    <style name="DocumentsTheme.SurfaceBarOverlay" parent="@style/ThemeOverlay.AppCompat.ActionBar">
        <item name="colorControlNormal">?attr/colorOnSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="DocumentsTheme.DailogPIN">
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="DocumentsTheme.Note">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
        <!-- The bar is the window's surface, so its title and buttons take the text's color -->
        <item name="actionBarTheme">@style/DocumentsTheme.SurfaceBarOverlay</item>
    </style>
    <style name="EditTextAppTheme" parent="DocumentsTheme">
        <item name="colorControlNormal">@color/defaultThemeColor</item>
        <item name="colorControlActivated">@color/defaultThemeColor</item>
        <item name="colorControlHighlight">@color/defaultThemeColor</item>
    </style>
</resources>