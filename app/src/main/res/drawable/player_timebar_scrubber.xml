<?xml version="1.0" encoding="utf-8"?>
<!-- The time bar circle: grows with a white ring on focus, larger still while OK has switched on scrubbing -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true" android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/accentColor" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <size android:width="28dp" android:height="28dp" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/accentColor" />
            <stroke android:width="4dp" android:color="#FFFFFFFF" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="@color/accentColor" />
            <size android:width="12dp" android:height="12dp" />
        </shape>
    </item>
</selector>
